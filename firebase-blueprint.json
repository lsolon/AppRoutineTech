{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "A client created by the professional",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 200 },
        "lastService": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "phone", "createdAt"]
    },
    "Quote": {
      "title": "Quote",
      "description": "A quote generated for a client",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string", "maxLength": 100 },
        "service": { "type": "string", "maxLength": 100 },
        "hours": { "type": "number" },
        "hourlyRate": { "type": "number" },
        "materialsTotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pendente", "aprovado", "concluido", "recusado"] },
        "recurrencePeriod": { "type": "string" },
        "updatedAt": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "customerName", "service", "total", "status", "createdAt"]
    },
    "ServiceType": {
      "title": "ServiceType",
      "description": "Catalog of service types with pre-defined recurrence periods",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 300 },
        "defaultRecurrence": { "type": "string" },
        "defaultHours": { "type": "number" },
        "defaultHourlyRate": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "defaultRecurrence", "createdAt"]
    },
    "QuoteRequest": {
      "title": "QuoteRequest",
      "description": "Public quote requests submitted from the landing page",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "service": { "type": "string", "maxLength": 500 },
        "referralSource": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pendente", "atendido", "convertido"] },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "whatsapp", "service", "createdAt"]
    },
    "CompanyInfo": {
      "title": "CompanyInfo",
      "description": "Company registration info, including WhatsApp number, name, and address",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "companyName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "cnpj": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "pixKey": { "type": "string", "maxLength": 100 },
        "notes": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "number" }
      },
      "required": ["companyName", "phone"]
    }
  },
  "firestore": {
    "customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customers managed by a user"
    },
    "quotes/{quoteId}": {
      "schema": { "$ref": "#/entities/Quote" },
      "description": "Quotes generated by a user"
    },
    "serviceTypes/{serviceTypeId}": {
      "schema": { "$ref": "#/entities/ServiceType" },
      "description": "Customizable service catalog for a user"
    },
    "quoteRequests/{requestId}": {
      "schema": { "$ref": "#/entities/QuoteRequest" },
      "description": "Public requests submitted by landing page visitors"
    },
    "companyInfo/{infoId}": {
      "schema": { "$ref": "#/entities/CompanyInfo" },
      "description": "Company profile details used on the landing page and invoices"
    }
  }
}
